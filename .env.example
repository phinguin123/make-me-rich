# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Kiwoom Open API credentials
APP_KEY=YOUR_APP_KEY_HERE
APP_SECRET=YOUR_APP_SECRET_HERE

# Optional aliases used by some KR tools (fall back to APP_KEY / APP_SECRET)
# KIWOOM_APPKEY=
# KIWOOM_SECRETKEY=

# Alpaca paper API (US screeners)
ALPACA_API_KEY=YOUR_ALPACA_KEY_HERE
ALPACA_API_SECRET=YOUR_ALPACA_SECRET_HERE
# Alpaca data plan: sip (Algo Trader Plus: real-time full market + stream, default), iex (free), off
# TRADER_ALPACA_FEED=sip

# Primary stock to stream on startup (6-digit KRX code)
TARGET_TICKER=044450

# Set to "true" to use the built-in order-book simulator instead of Kiwoom.
# Useful for UI development without a live Kiwoom account.
KIWOOM_DUMMY=true

# Host port for the frontend container (default 80)
FRONTEND_PORT=80

# Toss Securities API credentials (WTS > 설정 > Open API). Calls only work from
# allow-listed IPs; only one process may use these keys at a time.
TOSS_CLIENT_ID=YOUR_TOSS_CLIENT_ID_HERE
TOSS_CLIENT_SECRET=YOUR_TOSS_CLIENT_SECRET_HERE
# accountSeq from GET /api/v1/accounts (usually 1)
TOSS_ACCOUNT_SEQ=1

# Toss auto trader (toss_dashboard/). See toss_dashboard/README.md.
# paper = simulated fills on live Toss quotes, live = real orders
TRADER_MODE=paper
# Intraday breakout sleeve capital (USD)
TRADER_CAPITAL=1500
# Swing sleeve: monthly momentum rotation, weeks-to-months holds (0 disables)
TRADER_SWING_CAPITAL=3500
# Optional SOXS hedge for the swing sleeve: none | soxs_broad
TRADER_SWING_HEDGE=none
# SOXL/SOXS scalp sleeve (bear-regime opening-range breakout, regular session). 0 disables it.
TRADER_SCALP_CAPITAL=0
# Pre-market edge of the scalp sleeve (SOXL dips below the pre-market VWAP, 07:00-09:25 ET). 0 disables it.
# TRADER_SCALP_PRE=1
# Split between the scalp and swing sleeves (shares of their combined money; validated 30/70).
# TRADER_SCALP_CAPITAL / TRADER_SWING_CAPITAL seed the very first run; afterwards the allocator keeps the shares.
# TRADER_SCALP_POSITION_FRAC=1.0
# TRADER_ALLOC_SCALP=0.25
# TRADER_ALLOC_SWING=0.60   # the remaining 15% is a cash reserve the bot never trades
# TRADER_ALLOC_REBALANCE=yearly   # yearly | off
# Glide path on the bot's money (overrides the fixed shares; one-way towards safer phases):
# TRADER_ALLOC_PHASES=0:0.30/0.70,50000:0.25/0.75,100000:0.20/0.50
# Pause new entries when scalp + swing + reserve is this far below its peak (0 = off)
# TRADER_ACCOUNT_DD_HALT=0.20
# TRADER_RISK_PER_TRADE=0.01
# TRADER_MAX_POSITIONS=4
# TRADER_MAX_POSITION_PCT=0.35
# TRADER_DAILY_LOSS_LIMIT=0.03
# TRADER_MAX_ORDERS_10MIN=20
# TRADER_MAX_ORDERS_DAY=120
# TRADER_HOLD_OVERNIGHT=true
# TRADER_SERVER_STOPS=true
# Required for the dashboard API when it is reachable from other machines
# TRADER_DASHBOARD_TOKEN=
